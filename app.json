{
  "expo": {
    "name": "Allergy App",
    "slug": "allergy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "allergyapp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.officialjwise.allergyapp",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "We use your camera to scan food, labels and menus and check them against your restrictions.",
        "NSPhotoLibraryUsageDescription": "We use your photo library so you can check a photo of a food, label or menu against your restrictions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.officialjwise.allergyapp",
      "adaptiveIcon": {
        "backgroundColor": "#1C1A20",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "We use your camera to scan food, labels and menus and check them against your restrictions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "We use your photo library so you can check a photo of a food, label or menu against your restrictions."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1C1A20"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
